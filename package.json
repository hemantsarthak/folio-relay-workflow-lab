{
  "name": "rivet-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs --production",
    "build": "node scripts/prepare-public.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "format:check": "prettier --check apps src server netlify tests scripts/*.mjs index.html vite.config.ts tsconfig.json package.json",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "dotenv": "18.0.2",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
